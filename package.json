{
  "name": "openchamber-image-guard",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "description": "Caps image parts per model request for providers with a low image limit, with a settings panel for per-model limits.",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.0.0"
    },
    "id": "image-guard",
    "name": "Image Guard",
    "icon": "image",
    "contributes": {
      "panel": {
        "id": "image-guard",
        "name": "Image Guard",
        "icon": "image",
        "entry": "panel/index.html"
      },
      "opencodePlugin": "plugin",
      "filesystem": [
        "~/.config/opencode/image-guard.json"
      ]
    }
  },
  "scripts": {
    "build": "bunx openchamber-guest-bundle src/panel/main.ts panel/main.js"
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.3.3"
  }
}
